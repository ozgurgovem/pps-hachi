{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PPS Hachi",
  "version": "0.1.0",
  "identifier": "com.ppshachi.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PPS Hachi",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["default", "a3-preview"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Toyota 8-step Practical Problem Solving A3 report builder"
  }
}

